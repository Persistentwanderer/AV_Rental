# Local placeholders only. Copy to .env (gitignored) before `docker compose up`.
# Change the passwords before any shared or non-local use. Do not commit .env.

# Pinned ERPNext image produced by frappe/frappe_docker. Bump both together.
ERPNEXT_VERSION=v16.54.0
CUSTOM_IMAGE=avrental-erpnext
CUSTOM_TAG=v16.54.0
PULL_POLICY=never

# Browser URL is http://127.0.0.1:18080
# 18080 is intentional: 8080 is a common local clash.
# nginx inside the container still listens on 8080 (frappe_docker default).
HTTP_PUBLISH_PORT=18080
NGINX_LISTEN_PORT=8080

# Sent as the site name so the desk works on http://127.0.0.1:18080
# without a matching Host header. The site created by scripts/create-site.sh
# uses the same name.
FRAPPE_SITE_NAME_HEADER=avrental.localhost
SITE_NAME=avrental.localhost

# Local-only placeholders. Compose uses change-me when DB_PASSWORD is unset.
DB_PASSWORD=change-me
ADMIN_PASSWORD=change-me

# Modest defaults for a laptop. Raise them on a larger machine.
GUNICORN_WORKERS=1
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
